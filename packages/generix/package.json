{
  "private": false,
  "name": "@math-x-ts/generix",
  "description": "The task of this library is to generate combinations and permutations.",
  "version": "0.0.12",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "unpkg": "./lib/umd/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "postbuild:cpp": "node -p \"const fs = require('fs'); fs.rmdirSync('node_addons', { recursive: true }); fs.renameSync('build', 'node_addons');\"",
    "postbuild:all": "node -p \"const fs = require('fs'); fs.cpSync('node_addons', 'lib/node_addons', {recursive: true});",
    "clean:cpp": "node-gyp clean",
    "build:cpp": "node-gyp rebuild",
    "clean:lib": "rimraf lib",
    "build:types": "tsc --emitDeclarationOnly --declaration true --outDir lib/types",
    "build:esm": "tsc --module es2015 --target es5 --outDir lib/esm",
    "build:cjs": "tsc --module commonjs --target es5 --outDir lib/cjs",
    "build:umd": "webpack --config webpack.config.js",
    "build": "npm run clean:lib && npm run build:types && npm run build:esm && npm run build:cjs && npm run build:umd",
    "check:types": "tsc --noEmit",
    "lint": "eslint ./src/**/*",
    "lint:fix": "eslint ./src/**/* --fix",
    "test": "jest --verbose",
    "coverage": "c8 npm run test",
    "test:bundle": "jest --config ./jest.bundle.config.ts --detectOpenHandles --verbose",
    "check:all": "npm run check:types && npm run lint && npm run test",
    "npm:publish": "npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dopey2/math-x-ts"
  },
  "keywords": [
    "Generation",
    "Combination",
    "Permutation"
  ],
  "homepage": "https://github.com/dopey2/math-x-ts/blob/main/packages/generix/README.md",
  "license": "MIT",
  "devDependencies": {
    "node-addon-api": "7.1.0",
    "node-gyp": "10.0.1"
  }
}
